# Operator agent settings. Copy to ~/.operator/agent.env, run `chmod 600 ~/.operator/agent.env`,
# then fill it in. NEVER commit the filled-in copy. deploy/setup.sh reads it and never prints values.

# ---- Who and where (used in SOUL.md and the skills) -------------------------
AGENT_NAME=The Operator
OWNER_NAME=
ORG_NAME=
# IANA timezone, for example America/Chicago or Europe/Berlin. Cron schedules use it.
TIMEZONE=
# The system of record for task status, for example "the vault", or the name of your PM tool.
PM_SYSTEM=the vault
# Where the agent's PARA vault lives on this machine. Created from vault-template/ if missing.
VAULT_DIR=$HOME/operator-vault

# ---- Model (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
# An OpenRouter model id in vendor/model form, chosen from openrouter.ai/models.
OPERATOR_MODEL=

# ---- Tool permissions (see hermes/config.template.yaml for the trade-offs) ---
# vault = file tools on, writes confined to VAULT_DIR (default) | off = no file tools at all
OPERATOR_FILE_ACCESS=vault
# true = give the agent a shell and code execution. Leave false unless you need it.
OPERATOR_ENABLE_SHELL=false

# ---- Routines (daily status brief + weekly report) ---------------------------
# setup.sh asks "Schedule them now? [y/N]" when run in a terminal. Pre-answer here (or with
# --routines yes|no) for unattended installs. Each run is a model call billed to OpenRouter.
# PM_ROUTINES=no
# Daily brief runs on weekdays and the weekly report on Fridays, at these times in TIMEZONE.
# PM_DAILY_TIME=08:00
# PM_WEEKLY_TIME=16:00

# ---- Optional: your PM system's API token ------------------------------------
# Written to ~/.hermes/.env so an MCP server in ~/.operator/mcp_servers.yaml can use ${PM_SYSTEM_TOKEN}.
# PM_SYSTEM_TOKEN=

# ---- Optional: Slack (off by default) ----------------------------------------
# Without Slack the owner uses the agent from the desktop terminal (`hermes`) and routine output
# stays local (`hermes cron runs`, ~/.hermes/cron/output/). To turn Slack on, set
# OPERATOR_ENABLE_SLACK=true and fill in all four values below.
# OPERATOR_ENABLE_SLACK=false
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Comma-separated Slack member IDs allowed to talk to the agent. Required when Slack is on.
# SLACK_ALLOWED_USERS=
# Channel ID where routine output is posted.
# SLACK_HOME_CHANNEL=
